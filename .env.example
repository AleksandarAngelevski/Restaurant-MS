# Copy to .env. docker compose and the backend both read these.
DB_HOST=localhost
# The university database is reached through an SSH tunnel on a local port (e.g. 5433)
DB_PORT=5432
DB_NAME=rms
DB_USER=rms
DB_PASSWORD=rms
# Load db/dev/demo_seed.sql on first start when the database has no employees
APP_DEMO_SEED=true
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
BACKEND_PORT=8080
FRONTEND_PORT=5173
